# Copy this file to `.env` and fill in your keys. Never commit the real .env.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ElevenLabs — https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional overrides (sensible defaults shown)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
CLAUDE_MODEL=claude-haiku-4-5

# Optional: enables exact "play this song" on Spotify (Web API catalog search).
# Create a free app at https://developer.spotify.com/dashboard to get these.
# Without them, play still works in best-effort mode (opens search + plays).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
